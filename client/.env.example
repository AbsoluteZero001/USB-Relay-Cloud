# Web 同源部署（Nginx 反代 /api 与 /ws）时可以不设置下面两项，
# 前端会自动使用「当前页面 origin」派生 REST / WebSocket 地址。
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_BASE_URL=ws://localhost:8080/ws/relay
VITE_APP_ENV=development

# 构建期烘焙的默认服务器根地址（仅作为首次启动的默认值，不写死业务逻辑）。
# - Android APK：不设置时自动使用 src/config/runtimeConfig.ts 里的 DEFAULT_SERVER_URL
# - Web：建议留空，走同源相对路径，避免把域名散落到构建产物里
# VITE_DEFAULT_SERVER_BASE_URL=https://relay.evezero.cn
