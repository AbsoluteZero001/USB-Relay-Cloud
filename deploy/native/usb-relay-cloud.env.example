# ============================================================
# USB Relay Cloud Spring Boot 服务环境变量
#
# 路径: /etc/usb-relay-cloud/usb-relay-cloud.env
# 加载: systemd 通过 EnvironmentFile= 加载本文件
#
# 部署步骤：
#   sudo mkdir -p /etc/usb-relay-cloud
#   sudo cp deploy/native/usb-relay-cloud.env.example \
#        /etc/usb-relay-cloud/usb-relay-cloud.env
#   sudo nano /etc/usb-relay-cloud/usb-relay-cloud.env
#   sudo chown usbrelay:usbrelay /etc/usb-relay-cloud/usb-relay-cloud.env
#   sudo chmod 600 /etc/usb-relay-cloud/usb-relay-cloud.env
#
# 该文件含敏感信息（数据库密码、JWT 密钥），不要提交 Git，
# 不要让其他用户可读（chmod 600）。
# ============================================================

# ---- Spring Boot ----
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ---- MySQL 连接（指向本地 MySQL 实例） ----
# 127.0.0.1:3306 由 mysql.service 提供，不暴露公网
# forceConnectionTimeZoneToSession=true 保证时间字段一致
DB_URL=jdbc:mysql://127.0.0.1:3306/usb_relay_cloud?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&allowPublicKeyRetrieval=false&useSSL=false
DB_USERNAME=usb_relay
DB_PASSWORD=replace-with-a-strong-password

# ---- JWT（生产必填，≥ 32 字符） ----
# 生成: openssl rand -base64 48
JWT_SECRET=replace-with-a-32-char-min-random-secret
JWT_EXPIRATION=1h

# ---- 初始管理员账号 ----
# 仅在 sys_user 表为空时创建；已存在则跳过
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ---- CORS 允许的来源白名单 ----
# 多个用逗号分隔；* 仅用于开发
# 生产应填写实际域名，如 https://relay.evezero.cn
# 注意：Capacitor Android App 的 WebView Origin（https://localhost、
#      http://localhost、capacitor://localhost）由服务端 CorsConfig 内置放行，
#      不需要写在这里；这里只需填浏览器访问的 Web 域名。
APP_CORS_ALLOWED_ORIGINS=https://relay.example.com
