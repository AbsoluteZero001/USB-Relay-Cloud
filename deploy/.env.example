# ============================================================
# USB Relay Cloud 部署环境变量
# 复制为 .env 并替换所有 replace-with-* 值后再启动
# ============================================================

# ---- MySQL ----
MYSQL_DATABASE=usb_relay_cloud
MYSQL_USER=usb_relay
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password

# ---- 对外端口（Nginx 监听） ----
# ECS 公网开放端口：Host 8088 → Nginx 80
# SpringBoot 8080 / MySQL 3306 仅 Docker 内网，不暴露公网
HTTP_PORT=8088

# ---- JWT（生产必填，≥ 32 字符） ----
# 可用：openssl rand -base64 48
JWT_SECRET=replace-with-a-32-char-min-random-secret

# ---- 初始管理员账号 ----
# 仅在 sys_user 表为空时创建；已存在用户则跳过
# 生产环境不配置则不会创建管理员，需手动插入
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ---- CORS 允许的来源白名单 ----
# 多个用逗号分隔；* 仅用于开发
# Capacitor Android App 的 WebView Origin（https://localhost 等）由服务端
# CorsConfig 内置放行，不需要写在这里。
APP_CORS_ALLOWED_ORIGINS=*
